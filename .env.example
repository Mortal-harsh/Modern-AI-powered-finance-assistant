# Oracle Database Connection Configuration
# Modify these values to match your Oracle Database environment

# Oracle connection credentials
ORACLE_USER=expense_tracker
ORACLE_PASSWORD=ExpenseTracker123#
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=xe

# Full DSN (takes precedence if provided, e.g. localhost:1521/xe or localhost:1521/XEPDB1)
ORACLE_DSN=localhost:1521/xe

# Oracle Client Directory (Leave empty for Thin Mode on Oracle 12c, 19c, 21c, 23ai)
# Provide path if connecting to Oracle 11g or using Thick mode
ORACLE_CLIENT_DIR=instantclient_19_23

# Default User Profile
DEFAULT_USER_ID=1
DEFAULT_USERNAME=demo_user
